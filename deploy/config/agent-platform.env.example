# Copy to /etc/agent-platform/agent-platform.env and set mode 600.
PLATFORM_DB_URL=jdbc:postgresql://127.0.0.1:5432/agent_platform
PLATFORM_DB_USERNAME=agent_platform
PLATFORM_DB_PASSWORD=CHANGE_ME
PLATFORM_ADMIN_USERNAME=admin
PLATFORM_ADMIN_PASSWORD_FILE=/etc/agent-platform/secure/admin-password.txt
PLATFORM_MASTER_KEY_ID=production-v1
PLATFORM_MASTER_KEY_FILE=/etc/agent-platform/secure/master-key.txt
PLATFORM_ALLOWED_OUTBOUND_HOSTS=127.0.0.1,localhost,model.example.internal,mysql.example.internal,elasticsearch.example.internal
PLATFORM_STORAGE_ROOT=/var/lib/agent-platform/data
PLATFORM_LOG_FILE=/var/log/agent-platform/agent-platform.log
PLATFORM_SERVER_ADDRESS=127.0.0.1
PLATFORM_SERVER_PORT=8080
PLATFORM_SECURE_COOKIE=true
PLATFORM_MAX_ACTIVE_TASKS_PER_USER=2
PLATFORM_MAX_TASKS_PER_HOUR_PER_USER=60
PLATFORM_MAX_FAILED_LOGINS=5
PLATFORM_LOGIN_LOCK_MINUTES=15
PLATFORM_LOG_MODEL_CONTENT=false
JAVA_OPTS=-Xms512m -Xmx2g -XX:+ExitOnOutOfMemoryError
